# Copy to .env (never commit .env) and export before running.
DATABASE_URL=postgresql://fairflow:change-me@localhost:5432/fairflow_db
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-value-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
DB_POOL_MAX=10
# Seconds a request waits for a free DB connection before answering 503
DB_POOL_TIMEOUT=30
# "Today" for distribution dates, the same-day rule and forecast months
APP_TIMEZONE=Asia/Kolkata
APP_ENV=development
# mock = simulation for local testing only; disabled = endpoint returns 503
BIOMETRIC_PROVIDER=disabled
# mock = record "simulated" (nothing sent); disabled = record "disabled"
SMS_PROVIDER=disabled
# Fingerprint sign-in (WebAuthn passkeys). Use the domain/address users actually open.
# Local: localhost + http://localhost:8000. Production: your domain + https://your-domain
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8000
WEBAUTHN_RP_NAME=FairFlow
# Mobile apps (leave empty if there is none). Same RP_ID as the web app, served over HTTPS.
ANDROID_APP_PACKAGE=
# SHA-256 of the app signing certificate(s), comma-separated, e.g. AB:CD:...:EF
ANDROID_APP_SHA256_CERT_FINGERPRINTS=
# TEAMID.bundle.id, comma-separated
IOS_APP_IDS=
ACTIVATION_CODE_TTL_HOURS=24
# Password sign-in is off; only automated tests turn it on
ALLOW_PASSWORD_LOGIN=false
# Sign-in/sign-up attempts per client per minute (0 = off)
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_SIGNUP_PER_HOUR=10
# Number of reverse proxies in front of the API (0 = clients connect directly).
# Needed so rate limits count real client addresses, not the proxy.
TRUSTED_PROXY_COUNT=0
MAX_PENDING_SIGNUPS_PER_SHOP=200
# Comma-separated; only if a client runs on ANOTHER origin (e.g. Flutter web on :5000)
CORS_ORIGINS=
# First run: `python setup_db.py` creates this admin and prints an activation code
ADMIN_USERNAME=admin
# Tests only: must be a separate database whose name contains "test"
TEST_DATABASE_URL=postgresql://fairflow:change-me@localhost:5432/fairflow_test
